{
  "name": "pyric-games",
  "private": true,
  "type": "module",
  "workspaces": ["app", "packages/*", "games/*"],
  "scripts": {
    "dev": "bun run --cwd app dev",
    "rules:resolve": "bun run --cwd app rules:resolve",
    "test": "bun run rules:resolve && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "overrides": {
    "pyric": "file:./vendor/pyric/pyric-local-1.tgz",
    "@pyric/cli": "file:./vendor/pyric/pyric-cli-local-1.tgz",
    "@pyric/ui": "file:./vendor/pyric/pyric-ui-local-1.tgz"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "phaser": "4.2.1"
  },
  "//": "js-md5 and js-sha256 are pyric's own dependencies; listing them here lets Vite pre-bundle them for pyric's page runtime under Bun's isolated installs.",
  "optionalDependencies": {
    "js-md5": "^0.8.3",
    "js-sha256": "^0.11.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@pyric/cli": "file:./vendor/pyric/pyric-cli-local-1.tgz",
    "@pyric/ui": "file:./vendor/pyric/pyric-ui-local-1.tgz",
    "pyric": "file:./vendor/pyric/pyric-local-1.tgz",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
