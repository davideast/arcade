{
  "name": "pyric-games",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "bun run --cwd app dev",
    "rules:resolve": "bun run --cwd app rules:resolve",
    "rtdb:rules": "bun tools/rtdb-rules.ts",
    "lint": "bun run rules:resolve && bun tools/lint-rules.ts && bun tools/rtdb-rules.ts --check",
    "test": "bun run rules:resolve && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "overrides": {
    "pyric": "file:./vendor/pyric/pyric-local-6.tgz",
    "@pyric/cli": "file:./vendor/pyric/pyric-cli-local-6.tgz",
    "@pyric/ui": "file:./vendor/pyric/pyric-ui-local-6.tgz",
    "pyric-admin": "file:./vendor/pyric/pyric-admin-local-6.tgz"
  },
  "dependencies": {
    "@fontsource/silkscreen": "5.3.0",
    "firebase": "^12.12.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "@pyric/cli": "file:./vendor/pyric/pyric-cli-local-6.tgz",
    "@pyric/ui": "file:./vendor/pyric/pyric-ui-local-6.tgz",
    "pyric": "file:./vendor/pyric/pyric-local-6.tgz",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0",
    "pyric-admin": "file:./vendor/pyric/pyric-admin-local-6.tgz"
  }
}
