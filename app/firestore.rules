    return request.auth != null && lobby__isWaiting() && request.resource.data.guest == request.auth.uid && request.auth.uid != resource.data.host && request.resource.data.status == 'playing' && request.resource.data.host == resource.data.host;
  }
  function canCancel() {
    return request.auth != null && resource.data.status == 'waiting' && request.auth.uid == resource.data.host;
  }
  function onlyFieldsChanged(fields) {
    return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
  }
  function isMyTurn() {
    return resource.data.currentTurn == 'host' && request.auth.uid == resource.data.host || resource.data.currentTurn == 'guest' && request.auth.uid == resource.data.guest;
  }
  function turnFlipped() {
    return resource.data.currentTurn == 'host' && request.resource.data.currentTurn == 'guest' || resource.data.currentTurn == 'guest' && request.resource.data.currentTurn == 'host';
  }
  function isPlaying() {
    return resource.data.status == 'playing';
  }
  function moveIncremented() {
    return request.resource.data.moveCount == resource.data.moveCount + 1;
  }
  function _games_tictactoe_tictactoe__cellNames() {
    return ['c0r0', 'c1r0', 'c2r0', 'c0r1', 'c1r1', 'c2r1', 'c0r2', 'c1r2', 'c2r2'];
  }
  function ticTacToeCreate() {
    return validCreate() && request.resource.data.keys().hasOnly(['host', 'guest', 'currentTurn', 'status', 'winner', 'moveCount', 'board', 'lastMove', 'createdAt']) && request.resource.data.currentTurn == 'host' && request.resource.data.winner == '' && request.resource.data.moveCount == 0 && request.resource.data.lastMove == '' && request.resource.data.createdAt == request.time && request.resource.data.board.keys().hasOnly(_games_tictactoe_tictactoe__cellNames()) && request.resource.data.board.size() == 9 && request.resource.data.board.values().hasOnly(['']);
