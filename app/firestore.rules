  function ticTacToeDraw() {
    return request.resource.data.winner == '' && _games_tictactoe_tictactoe__moveBasics() && _games_tictactoe_tictactoe__placedOneCell() && request.resource.data.moveCount == 9;
  }
  function ticTacToeResign() {
    let uid = request.auth.uid;
    return request.auth != null && isPlaying() && (uid == resource.data.host || uid == resource.data.guest) && onlyFieldsChanged(['status', 'winner']) && request.resource.data.winner == (uid == resource.data.host ? 'guest' : 'host');
  }
  match /databases/{database}/documents {
    match /tictactoe/{matchId} {
      allow read: if request.auth != null;
      allow create: if ticTacToeCreate();
      allow delete: if ticTacToeCancel();
      allow update: if resource.data.status == 'waiting' && ticTacToeJoin();
      allow update: if request.resource.data.status == 'playing' && resource.data.status == 'playing' && ticTacToeMove();
      allow update: if request.resource.data.winner == 'host' && request.resource.data.status == 'won' && ticTacToeWin('host');
      allow update: if request.resource.data.winner == 'guest' && request.resource.data.status == 'won' && ticTacToeWin('guest');
