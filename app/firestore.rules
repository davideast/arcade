    return resource.data.board[request.resource.data.lastMove] == '' && request.resource.data.board[request.resource.data.lastMove] == resource.data.currentTurn && request.resource.data.board.diff(resource.data.board).affectedKeys().hasOnly([request.resource.data.lastMove]) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['board', 'lastMove', 'currentTurn', 'moveCount', 'status', 'winner']);
  }
  function ticTacToeMove() {
    return request.resource.data.winner == '' && _games_tictactoe_tictactoe__moveBasics() && _games_tictactoe_tictactoe__placedOneCell();
  }
  function _games_tictactoe_tictactoe__line(b, mark, a, c, d) {
    return b[a] == mark && b[c] == mark && b[d] == mark;
  }
  function _games_tictactoe_tictactoe__hasLine(b, mark) {
    return _games_tictactoe_tictactoe__line(b, mark, 'c0r0', 'c1r0', 'c2r0') || _games_tictactoe_tictactoe__line(b, mark, 'c0r1', 'c1r1', 'c2r1') || _games_tictactoe_tictactoe__line(b, mark, 'c0r2', 'c1r2', 'c2r2') || _games_tictactoe_tictactoe__line(b, mark, 'c0r0', 'c0r1', 'c0r2') || _games_tictactoe_tictactoe__line(b, mark, 'c1r0', 'c1r1', 'c1r2') || _games_tictactoe_tictactoe__line(b, mark, 'c2r0', 'c2r1', 'c2r2') || _games_tictactoe_tictactoe__line(b, mark, 'c0r0', 'c1r1', 'c2r2') || _games_tictactoe_tictactoe__line(b, mark, 'c2r0', 'c1r1', 'c0r2');
  }
  function ticTacToeWin(seat) {
    return request.resource.data.status == 'won' && _games_tictactoe_tictactoe__moveBasics() && _games_tictactoe_tictactoe__placedOneCell() && _games_tictactoe_tictactoe__hasLine(request.resource.data.board, seat);
