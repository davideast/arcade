rules_version = '2';
service firebase.storage {
  function storage_objects__objectName() {
    return request.method in ['create', 'update'] ? request.resource.name : resource.name;
  }
  function matchesDocument(path, field) {
    return request.auth != null && firestore.get(path).data[field] == storage_objects__objectName();
  }
  match /b/{bucket}/o {
    function sokobanUpload(uid, level) {
      let meta = request.resource.metadata;
      let score = firestore.get(/databases/(default)/documents/sokoban/$(level)/scores/$(uid)).data;
      return request.auth != null && request.auth.uid == uid && request.resource.contentType == 'text/plain' && request.resource.size <= 2000 && meta.keys().hasOnly(['level', 'moves', 'pushes']) && meta.level == level && matchesDocument(/databases/(default)/documents/sokoban/$(level)/scores/$(uid), 'object') && meta.moves == string(score.moves) && meta.pushes == string(score.pushes) && request.resource.size == score.moves;
    }
    match /sokoban/{uid}/{level}/{file} {
      allow read: if request.auth != null;
      allow create: if sokobanUpload(uid, level);
    }
  }
}
