rules_version = '2+modules';

// One ruleset for every game. Each game's rules live next to the game and are
// imported here; each match block starts every update rule with a comparison
// the other transitions can't pass, so a write pays for its own branch only.

import {
  ticTacToeCreate, ticTacToeJoin, ticTacToeCancel,
  ticTacToeMove, ticTacToeWin, ticTacToeDraw, ticTacToeResign
} from '../games/tictactoe/tictactoe';
import {
  unoCreate, unoJoin, unoStart, unoDeal, unoPlay, unoDraw, unoCancel,
  unoDeckCreate, unoDeckRead, unoDrawsCreate, unoPlayedCreate
} from '../games/uno/uno';
import {
  poolCreate, poolJoin, poolCancel, poolShot, poolFinish, poolResign
} from '../games/pool/pool';
import {
  battleshipCreate, battleshipJoin, battleshipCancel, battleshipReady, battleshipBoardCreate,
  battleshipBoardRead, battleshipShotCreate, battleshipShot, battleshipResign
} from '../games/battleship/battleship';
import { chessCreate, chessJoin, chessCancel, chessMove, chessResign } from '../games/chess/chess';
import { checkersCreate, checkersJoin, checkersCancel, checkersMove, checkersResign } from '../games/checkers/checkers';
import {
  yachtCreate, yachtJoin, yachtCancel, yachtStart, yachtCommit, yachtNonce, yachtReveal, yachtScore
} from '../games/yacht/yacht';
import {
  reversiCreate, reversiJoin, reversiCancel, reversiMove, reversiPass, reversiResign
} from '../games/reversi/reversi';
import {
  airHockeyCreate, airHockeyJoin, airHockeyCancel, airHockeyFinish, airHockeyForfeit, airHockeyResign
} from '../games/air-hockey/airhockey';
import { sokobanScoreCreate, sokobanScoreImprove } from '../games/sokoban/sokoban';
import { rematchCreate, newMatchOrRematch } from '../packages/turn-net/rematch';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tictactoe/{matchId} {
      allow read: if request.auth != null;
      allow create: if ticTacToeCreate() && newMatchOrRematch(database, 'tictactoe');
      allow delete: if ticTacToeCancel();
      allow update: if resource.data.status == 'waiting' && (ticTacToeJoin());
      allow update: if request.resource.data.status == 'playing' && resource.data.status == 'playing' && (ticTacToeMove());
      allow update: if request.resource.data.winner == 'host' && request.resource.data.status == 'won' && (ticTacToeWin('host'));
      allow update: if request.resource.data.winner == 'guest' && request.resource.data.status == 'won' && (ticTacToeWin('guest'));
      allow update: if request.resource.data.status == 'draw' && (ticTacToeDraw());
      allow update: if request.resource.data.status == 'resigned' && (ticTacToeResign());
    }
    match /uno/{matchId} {
      allow read: if request.auth != null;
      allow create: if unoCreate();
      allow delete: if unoCancel();
      allow update: if request.resource.data.lastAction == 'join' && (unoJoin());
      allow update: if request.resource.data.lastAction == 'start' && (unoStart());
      allow update: if request.resource.data.lastAction == 'deal' && (unoDeal(database, matchId));
      allow update: if request.resource.data.lastAction == 'play' && (unoPlay(database, matchId));
      allow update: if request.resource.data.lastAction in ['draw', 'pass'] && (unoDraw());

      match /deck/{i} {
        allow get: if request.auth != null && unoDeckRead(database, matchId, i);
        allow create: if unoDeckCreate(database, matchId, i);
      }
      match /draws/{i} {
        allow read: if request.auth != null && resource.data.uid == request.auth.uid;
        allow create: if request.auth != null && unoDrawsCreate(database, matchId, i);
      }
      match /played/{i} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && unoPlayedCreate(database, matchId, i);
      }
    }
    match /pool/{matchId} {
      allow read: if request.auth != null;
      allow create: if poolCreate() && newMatchOrRematch(database, 'pool');
      allow delete: if poolCancel();
      allow update: if resource.data.status == 'waiting' && (poolJoin());
      allow update: if request.resource.data.status == 'playing' && resource.data.status == 'playing' && (poolShot());
      allow update: if request.resource.data.status == 'won' && (poolFinish());
      allow update: if request.resource.data.status == 'resigned' && (poolResign());
    }
    match /battleship/{matchId} {
      allow read: if request.auth != null;
      allow create: if battleshipCreate() && newMatchOrRematch(database, 'battleship');
      allow delete: if battleshipCancel();
      allow update: if request.resource.data.status == 'placing' && resource.data.status == 'waiting' && (battleshipJoin());
      allow update: if resource.data.status == 'placing' && (battleshipReady(database, matchId));
      allow update: if resource.data.status == 'playing' && request.resource.data.status != 'resigned' && (battleshipShot(database, matchId));
      allow update: if request.resource.data.status == 'resigned' && (battleshipResign());

      match /boards/{uid} {
        allow get: if battleshipBoardRead(database, matchId, uid);
        allow create: if battleshipBoardCreate(database, matchId, uid);
      }
      match /shots/{shotId} {
        allow read: if request.auth != null;
        allow create: if battleshipShotCreate(database, matchId, shotId);
      }
    }
    match /chess/{matchId} {
      allow read: if request.auth != null;
      allow create: if chessCreate() && newMatchOrRematch(database, 'chess');
      allow delete: if chessCancel();
      allow update: if resource.data.status == 'waiting' && (chessJoin());
      allow update: if resource.data.status == 'playing' && request.resource.data.status in ['playing', 'won', 'draw'] && (chessMove());
      allow update: if request.resource.data.status == 'resigned' && (chessResign());
    }
    match /checkers/{matchId} {
      allow read: if request.auth != null;
      allow create: if checkersCreate() && newMatchOrRematch(database, 'checkers');
      allow delete: if checkersCancel();
      allow update: if resource.data.status == 'waiting' && (checkersJoin());
      allow update: if resource.data.status == 'playing' && request.resource.data.status in ['playing', 'won'] && (checkersMove());
      allow update: if request.resource.data.status == 'resigned' && (checkersResign());
    }
    match /yacht/{matchId} {
      allow read: if request.auth != null;
      allow create: if yachtCreate();
      allow delete: if yachtCancel();
      allow update: if request.resource.data.lastAction == 'join' && (yachtJoin());
      allow update: if request.resource.data.lastAction == 'start' && (yachtStart());
      allow update: if request.resource.data.lastAction == 'commit' && (yachtCommit());
      allow update: if request.resource.data.lastAction == 'nonce' && (yachtNonce());
      allow update: if request.resource.data.lastAction == 'reveal' && (yachtReveal());
      allow update: if request.resource.data.lastAction == 'score' && (yachtScore());
    }
    match /reversi/{matchId} {
      allow read: if request.auth != null;
      allow create: if reversiCreate() && newMatchOrRematch(database, 'reversi');
      allow delete: if reversiCancel();
      allow update: if resource.data.status == 'waiting' && (reversiJoin());
      allow update: if request.resource.data.lastMove.at != '' && request.resource.data.status in ['playing', 'won', 'draw'] && (reversiMove());
      allow update: if request.resource.data.lastMove.at == '' && request.resource.data.status == 'playing' && (reversiPass());
      allow update: if request.resource.data.status == 'resigned' && (reversiResign());
    }
    match /airhockey/{matchId} {
      allow read: if request.auth != null;
      allow create: if airHockeyCreate() && newMatchOrRematch(database, 'airhockey');
      allow delete: if airHockeyCancel();
      allow update: if resource.data.status == 'waiting' && (airHockeyJoin());
      allow update: if request.resource.data.endedBy == 'goals' && (airHockeyFinish());
      allow update: if request.resource.data.endedBy == 'forfeit' && (airHockeyForfeit());
      allow update: if request.resource.data.status == 'resigned' && (airHockeyResign());
    }
    match /sokoban/{level}/scores/{uid} {
      allow read: if request.auth != null;
      allow create: if sokobanScoreCreate(level, uid);
      allow update: if sokobanScoreImprove(level, uid);
    }
    match /rematches/{game}/matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if rematchCreate(database, game, matchId);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
