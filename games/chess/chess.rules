rules_version = '2+modules';

import { validCreate, validJoin, canCancel } from 'lobby';
import { onlyFieldsChanged } from 'lifecycle';
import { isMyTurn, turnFlipped } from 'turns';
import { isPlaying, moveIncremented } from 'state';

// Chess match rules. The host plays white. The match document follows the
// stdlib convention (host, guest, currentTurn, status, winner, moveCount) plus
// board (64 squares by name to piece codes like 'wq', '' when empty),
// castling, enPassant, the same three from before the last move, and
// lastMove {from, to, promotion, extra}.
//
// These rules check what a move can change without searching the board. They
// don't check piece geometry, check, or a checkmate or stalemate claim; the
// clients replay each move from the stored previous position and flag one
// that isn't legal chess.

function chessStartBoard() {
  return {
    'a8': 'br', 'b8': 'bn', 'c8': 'bb', 'd8': 'bq', 'e8': 'bk', 'f8': 'bb', 'g8': 'bn', 'h8': 'br',
    'a7': 'bp', 'b7': 'bp', 'c7': 'bp', 'd7': 'bp', 'e7': 'bp', 'f7': 'bp', 'g7': 'bp', 'h7': 'bp',
    'a6': '', 'b6': '', 'c6': '', 'd6': '', 'e6': '', 'f6': '', 'g6': '', 'h6': '',
    'a5': '', 'b5': '', 'c5': '', 'd5': '', 'e5': '', 'f5': '', 'g5': '', 'h5': '',
    'a4': '', 'b4': '', 'c4': '', 'd4': '', 'e4': '', 'f4': '', 'g4': '', 'h4': '',
    'a3': '', 'b3': '', 'c3': '', 'd3': '', 'e3': '', 'f3': '', 'g3': '', 'h3': '',
    'a2': 'wp', 'b2': 'wp', 'c2': 'wp', 'd2': 'wp', 'e2': 'wp', 'f2': 'wp', 'g2': 'wp', 'h2': 'wp',
    'a1': 'wr', 'b1': 'wn', 'c1': 'wb', 'd1': 'wq', 'e1': 'wk', 'f1': 'wb', 'g1': 'wn', 'h1': 'wr'
  };
}

// Castling moves the king two files from its home square and names the two
// rook squares, sorted, as the extra squares.
function chessCastleSquares(piece, color, from, to, extra) {
  let rank = color == 'w' ? '1' : '8';
  return piece == color + 'k' && from == 'e' + rank
    && ((to == 'g' + rank && extra == ['f' + rank, 'h' + rank])
        || (to == 'c' + rank && extra == ['a' + rank, 'd' + rank]));
}

export function chessCreate() {
  return validCreate()
    && request.resource.data.keys().hasOnly(['host', 'guest', 'currentTurn', 'status', 'winner', 'moveCount',
         'board', 'castling', 'enPassant', 'prevBoard', 'prevCastling', 'prevEnPassant', 'lastMove', 'createdAt'])
    && request.resource.data.currentTurn == 'host'
    && request.resource.data.winner == ''
    && request.resource.data.moveCount == 0
    && request.resource.data.createdAt == request.time
    && request.resource.data.board == chessStartBoard()
    && request.resource.data.prevBoard == chessStartBoard()
    && request.resource.data.castling == 'KQkq'
    && request.resource.data.prevCastling == 'KQkq'
    && request.resource.data.enPassant == ''
    && request.resource.data.prevEnPassant == ''
    && request.resource.data.lastMove == {'from': '', 'to': '', 'promotion': '', 'extra': []};
}

export function chessJoin() {
  return validJoin() && onlyFieldsChanged(['guest', 'status']);
}

export function chessCancel() {
  return canCancel();
}

// One move by the player on turn. `status` and `winner` follow the mover's
// claim: a win goes to the mover, a draw or a move that plays on names nobody.
export function chessMove() {
  let color = resource.data.currentTurn == 'host' ? 'w' : 'b';
  let mv = request.resource.data.lastMove;
  let piece = resource.data.board[mv.from];
  let target = resource.data.board[mv.to];
  let promo = mv.promotion;
  return request.auth != null && isPlaying() && isMyTurn() && turnFlipped() && moveIncremented()
    && request.resource.data.lastMove.keys().hasOnly(['from', 'to', 'promotion', 'extra'])
    && mv.from != mv.to
    && piece[0:1] == color
    && request.resource.data.board[mv.from] == ''
    && (target == '' || target[0:1] != color)
    && (target == '' || target[1:2] != 'k')
    && request.resource.data.board[mv.to] == (promo == '' ? piece : color + promo)
    && (promo == '' || (piece == color + 'p' && promo in ['q', 'r', 'b', 'n']
         && mv.to[1:2] == (color == 'w' ? '8' : '1')))
    && (request.resource.data.lastMove.extra.size() == 0
        || chessCastleSquares(piece, color, mv.from, mv.to, request.resource.data.lastMove.extra)
        || (piece == color + 'p' && mv.to == resource.data.enPassant
            && request.resource.data.lastMove.extra == [mv.to[0:1] + mv.from[1:2]]))
    && request.resource.data.board.keys().hasOnly(resource.data.board.keys())
    && request.resource.data.board.diff(resource.data.board).affectedKeys()
         .hasOnly([mv.from, mv.to] + request.resource.data.lastMove.extra)
    && request.resource.data.prevBoard == resource.data.board
    && request.resource.data.prevCastling == resource.data.castling
    && request.resource.data.prevEnPassant == resource.data.enPassant
    && request.resource.data.winner == (request.resource.data.status == 'won' ? resource.data.currentTurn : '')
    && onlyFieldsChanged(['board', 'castling', 'enPassant', 'prevBoard', 'prevCastling', 'prevEnPassant',
         'lastMove', 'currentTurn', 'moveCount', 'status', 'winner']);
}

export function chessResign() {
  let uid = request.auth.uid;
  return request.auth != null && isPlaying()
    && (uid == resource.data.host || uid == resource.data.guest)
    && onlyFieldsChanged(['status', 'winner'])
    && request.resource.data.winner == (uid == resource.data.host ? 'guest' : 'host');
}
